# LLM Provider: openai, aliyun, or anthropic
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Aliyun (通义千问) Configuration
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_MODEL=qwen-plus

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama 服务配置
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# GPU 加速配置
USE_GPU=true
GPU_DEVICE=cuda
GPU_MEMORY_FRACTION=0.8

# Configuration
PORT=3000
LOG_LEVEL=info
MEMORY_DIR=./memory
SKILLS_DIR=./skills
ENABLE_PERSISTENCE=true
PERSISTENCE_DIR=./sessions

# Platform Configuration

# Telegram Bot
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Discord Bot
DISCORD_ENABLED=false
DISCORD_TOKEN=your_discord_bot_token_here

# Slack Bot
SLACK_ENABLED=false
SLACK_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# WhatsApp Bot
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_PATH=./sessions/whatsapp

# Web Platform
WEB_ENABLED=false
WEB_API_URL=http://localhost:3000
WEB_API_KEY=your_web_api_key_here
WEB_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
