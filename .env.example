# LLM Provider: openai, aliyun, or anthropic
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Aliyun (通义千问) Configuration
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_MODEL=qwen-plus

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama 服务配置
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# GPU 加速配置
USE_GPU=true
GPU_DEVICE=cuda
GPU_MEMORY_FRACTION=0.8

# Configuration
PORT=3000
LOG_LEVEL=info
MEMORY_DIR=./memory
SKILLS_DIR=./skills
ENABLE_PERSISTENCE=true
PERSISTENCE_DIR=./sessions

# Platform Configuration

# Telegram Bot
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Discord Bot
DISCORD_ENABLED=false
DISCORD_TOKEN=your_discord_bot_token_here

# Slack Bot
SLACK_ENABLED=false
SLACK_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# WhatsApp Bot
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_PATH=./sessions/whatsapp

# Web Platform
WEB_ENABLED=false
WEB_API_URL=http://localhost:3000
WEB_API_KEY=your_web_api_key_here
WEB_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WeCom (企业微信) Platform
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
WECOM_SECRET=your_wecom_secret_here

# Reverse Control Engine
REVERSE_CONTROL_ENABLED=false
REVERSE_CONTROL_REQUIRE_APPROVAL=true
REVERSE_CONTROL_MAX_CONCURRENT=5
REVERSE_CONTROL_TIMEOUT=30000

# Proactive Engine
PROACTIVE_ENGINE_ENABLED=false
PROACTIVE_ENGINE_MAX_CONCURRENT=3
PROACTIVE_ENGINE_TASK_TIMEOUT=60000
PROACTIVE_ENGINE_WEBHOOK_PORT=3001

# Deep Thinking Engine
DEEP_THINKING_ENABLED=true
DEEP_THINKING_MAX_ITERATIONS=3
DEEP_THINKING_MIN_CONFIDENCE=0.85
DEEP_THINKING_SELF_REFLECTION=true
DEEP_THINKING_CRITIQUE=true
DEEP_THINKING_MULTI_PERSPECTIVE=true
DEEP_THINKING_LOGICAL_CONSISTENCY=true
DEEP_THINKING_MAX_TIME=30000

# Weather API (for proactive monitoring)
WEATHER_API_KEY=your_weather_api_key_here
