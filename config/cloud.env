# LocalBot Cloud Deployment Configuration

# Basic server configuration
PORT=3000
HOST=0.0.0.0

# AI Provider Configuration
# Set your preferred provider and API keys
LLM_PROVIDER=openai
OPENAI_API_KEY=
ALIYUN_API_KEY=
ALIYUN_MODEL=qwen-plus
ANTHROPIC_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
TENCENT_API_KEY=
ZHIPU_API_KEY=
SILICONCLOUD_API_KEY=

# Ollama Configuration (for local inference)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# Hardware Acceleration
USE_GPU=false
GPU_DEVICE=cpu
GPU_MEMORY_FRACTION=0.8

# Logging Configuration
LOG_LEVEL=info

# Storage Configuration
MEMORY_DIR=/app/data/memory
SKILLS_DIR=/app/data/skills
ENABLE_PERSISTENCE=true
PERSISTENCE_DIR=/app/data/sessions

# Security Configuration
# Add authentication tokens here if needed
AUTH_TOKEN=

# Performance Configuration
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000